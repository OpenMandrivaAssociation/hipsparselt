Include <cstring> for host memcpy/strcpy.

hipcc -x hip makes hip's __device__ memcpy the only candidate, so
these host helpers fail. libc string functions need an explicit
include even with clang++ as CXX.

--- a/library/src/hcc_detail/hipsparselt.cpp
+++ b/library/src/hcc_detail/hipsparselt.cpp
@@ -32,6 +32,7 @@
 #include <hipsparselt/hipsparselt.h>
 #include <rocsparselt.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <cstring>
 
 #define TO_STR2(x) #x
 #define TO_STR(x) TO_STR2(x)
@@ -954,7 +955,7 @@
 
     static constexpr char v[] = TO_STR(hipsparseltVersionTweak);
 
-    memcpy(rev, v, sizeof(v));
+    std::memcpy(rev, v, sizeof(v));
 
     return HIPSPARSE_STATUS_SUCCESS;
 }
@@ -972,7 +973,7 @@
     *archName = nullptr;
     auto arch = rocsparselt_internal_get_arch_name();
     *archName = (char*)malloc((arch.size() + 1) * sizeof(char));
-    strcpy(*archName, arch.c_str());
+    std::strcpy(*archName, arch.c_str());
     return HIPSPARSE_STATUS_SUCCESS;
 }
 catch(...)
